# flagon current-v1 Directory: read-only public Realm metadata. The protocol
# exposes no ingest operation; a fresh index is empty.
TEABAY_BIND=0.0.0.0:7781
TEABAY_METRICS_BIND=127.0.0.1:9095
TEABAY_PUBLIC_BASE_URL=http://localhost:7781

# Required current service identity and operator-verified DID resolution.
TEABAY_SERVICE_DID=did:web:directory.localhost
TEABAY_SERVICE_METHOD_HISTORY_HEAD=
TEABAY_SERVICE_VERSION_ID=
TEABAY_TRUST_DOMAIN=ak:trust_domain:local.test

DATABASE_URL=postgres://flagon:flagon@localhost:5432/flagon

# Realm query budgets; 0 disables the respective rate limit.
TEABAY_QUERY_MAX_QUERIES_PER_IP_PER_MIN=600
TEABAY_QUERY_MAX_RESOLVES_PER_RESOURCE_PER_MIN=120
# TEABAY_TRUSTED_PROXY=10.0.0.1,10.0.0.2
# TEABAY_CORS_ALLOW_ORIGIN=https://app.example

# Audit-only operator access. Static token works only in development.
# Production uses rotating HMAC credentials in admin_tokens.
# TEABAY_ADMIN_TOKEN=change-me
# TEABAY_ADMIN_CSRF_TOKEN=change-me
TEABAY_ADMIN_TOKEN_ROTATION_WINDOW_SECS=1800
TEABAY_DEVELOPMENT_MODE=false

TEABAY_DB_POOL_MAX_SIZE=16
TEABAY_DB_POOL_CONNECTION_TIMEOUT_SECS=5
