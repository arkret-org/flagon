# flagon current-v1 Directory: read-only public Realm metadata. The protocol
# exposes no ingest operation; a fresh index is empty.
FLAGON_BIND=0.0.0.0:7781
FLAGON_METRICS_BIND=127.0.0.1:9095
FLAGON_PUBLIC_BASE_URL=http://localhost:7781

# Required current service identity and operator-verified DID resolution.
FLAGON_SERVICE_DID=did:web:directory.localhost
FLAGON_SERVICE_METHOD_HISTORY_HEAD=
FLAGON_SERVICE_VERSION_ID=
FLAGON_TRUST_DOMAIN=ak:trust_domain:local.test

DATABASE_URL=postgres://flagon:flagon@localhost:5432/flagon

# Realm query budgets; 0 disables the respective rate limit.
FLAGON_QUERY_MAX_QUERIES_PER_IP_PER_MIN=600
FLAGON_QUERY_MAX_RESOLVES_PER_RESOURCE_PER_MIN=120
# FLAGON_TRUSTED_PROXY=10.0.0.1,10.0.0.2
# FLAGON_CORS_ALLOW_ORIGIN=https://app.example

# Audit-only operator access. Static token works only in development.
# Production uses rotating HMAC credentials in admin_tokens.
# FLAGON_ADMIN_TOKEN=change-me
# FLAGON_ADMIN_CSRF_TOKEN=change-me
FLAGON_ADMIN_TOKEN_ROTATION_WINDOW_SECS=1800
FLAGON_DEVELOPMENT_MODE=false

FLAGON_DB_POOL_MAX_SIZE=16
FLAGON_DB_POOL_CONNECTION_TIMEOUT_SECS=5
