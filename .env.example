# chadex — reference Contrix Directory Service
# Copy to .env and adjust for local development.

# HTTP listener
CHADEX_BIND=0.0.0.0:7781

# Public-facing base URL for generating absolute resource URLs and DID document
# `service` entries.
CHADEX_PUBLIC_BASE_URL=http://localhost:7781

# This Directory's service DID — referenced by resources in
# `cx.{kind}.discovery.directory_services` to opt in to ingest.
# v1 default: did:web; high-trust deployments: did:webvh.
CHADEX_SERVICE_DID=did:web:directory.localhost

# PostgreSQL
DATABASE_URL=postgres://chadex:chadex@localhost:5432/chadex

# Accept policy: `open` | `allowlist` | `trust_root_signed` | `operator_review`
# (spec: discovery-directory.md §8.9 `accept_policy_kind`)
CHADEX_ACCEPT_POLICY_KIND=open

# Optional URL or DID describing how a resource governance contact applies for
# inclusion (only meaningful when accept_policy_kind != open).
# CHADEX_ACCEPT_POLICY_REF=https://directory.example/apply

# Optional contact for operator-takedown notifications and appeals.
# CHADEX_TAKEDOWN_CONTACT=mailto:directory-admin@example

# TTL configuration (spec §8.6). Hard upper bound is 30 days = 2_592_000s.
CHADEX_DEFAULT_TTL_SECONDS=86400
CHADEX_MAX_TTL_SECONDS=604800
CHADEX_REVALIDATION_GRACE_SECONDS=3600

# Comma-separated list of accepted DID methods for ingest.
CHADEX_ACCEPTED_DID_METHODS=did:web,did:webvh,did:key,did:plc

# Comma-separated allowlist of resource DIDs (only honored when
# CHADEX_ACCEPT_POLICY_KIND=allowlist).
# CHADEX_ALLOWLIST_DIDS=did:web:acme.example,did:web:globex.example

# Replay protection — reject `as_of` further than N seconds from server time.
CHADEX_AS_OF_SKEW_SECONDS=300

# Pull-mode worker. Period in seconds; set to 0 to disable the pull worker.
CHADEX_PULL_INTERVAL_SECONDS=300

# CORS allow-origin for browser clients hitting query endpoints.
# CHADEX_CORS_ALLOW_ORIGIN=https://app.example

# Development-mode flag. When true, accept ephemeral signing keys and skip
# strict DID method-history checks (DEV ONLY — production MUST be false).
CHADEX_DEVELOPMENT_MODE=false
