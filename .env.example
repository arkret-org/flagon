# teabay — reference Arkret Directory Service
# Copy to .env and adjust for local development.

# HTTP listener
TEABAY_BIND=0.0.0.0:7781

# Prometheus listener. Keep loopback-only unless a sidecar/proxy is scraping it.
TEABAY_METRICS_BIND=127.0.0.1:9095

# Public-facing base URL for generating absolute resource URLs and DID document
# `service` entries.
TEABAY_PUBLIC_BASE_URL=http://localhost:7781

# This Directory's current full DID. Teabay projects the stable core service id
# used by business DTOs; it never treats that core id as a URL. The historical
# TEABAY_SERVICE_ID name is accepted only as a compatibility alias.
TEABAY_SERVICE_FULL_ID=did:web:directory.localhost
# Required verified resolution values for the current full DID. Do not derive
# or guess these values from the DID text; copy them from the accepted method
# resolution result. Empty values deliberately make startup fail.
TEABAY_SERVICE_METHOD_HISTORY_HEAD=
TEABAY_SERVICE_VERSION_ID=

# PostgreSQL
DATABASE_URL=postgres://teabay:teabay@localhost:5432/teabay

# Accept policy: `open` | `allowlist` | `trust_root_signed` | `operator_review`
# (spec: discovery-directory.md §8.9 `accept_policy_kind`)
TEABAY_ACCEPT_POLICY_KIND=open

# Optional URL or DID describing how a resource governance contact applies for
# inclusion (only meaningful when accept_policy_kind != open).
# TEABAY_ACCEPT_POLICY_REF=https://directory.example/apply

# Optional contact for operator-takedown notifications and appeals.
# TEABAY_TAKEDOWN_CONTACT=mailto:directory-admin@example

# TTL configuration (spec §8.6). Hard upper bound is 30 days = 2_592_000s.
TEABAY_DEFAULT_TTL_SECONDS=86400
TEABAY_MAX_TTL_SECONDS=604800
TEABAY_REVALIDATION_GRACE_SECONDS=3600

# Comma-separated accepted resource kinds for ingest. Unset means all v1
# directory resource kinds.
TEABAY_ACCEPTED_RESOURCE_KINDS=realm,organization,actor,applet,handle

# Comma-separated list of accepted DID methods for ingest.
TEABAY_ACCEPTED_DID_METHODS=did:web,did:webvh,did:key

# Comma-separated allowlist of resource DIDs (only honored when
# TEABAY_ACCEPT_POLICY_KIND=allowlist).
# TEABAY_ALLOWLIST_DIDS=did:web:acme.example,did:web:globex.example

# Replay protection — reject `as_of` further than N seconds from server time.
TEABAY_AS_OF_SKEW_SECONDS=300

# Pull-mode worker. Period in seconds; set to 0 to disable the pull worker.
TEABAY_PULL_INTERVAL_SECONDS=300

# Reserved cross-directory divergence detector. Keep 0: startup rejects a
# non-zero value until verified peer service-resolution carriers are wired.
TEABAY_DIVERGENCE_INTERVAL_SECONDS=0

# Query budgets.
TEABAY_RATE_LIMIT_PER_RESOURCE_PER_MIN=60
TEABAY_QUERY_MAX_QUERIES_PER_IP_PER_MIN=600
TEABAY_QUERY_MAX_RESOLVES_PER_RESOURCE_PER_MIN=120
# Spec §6.4 anti-enumeration quota: batches per requester per quota window,
# decoupled from the OPRF key epoch.
TEABAY_MAX_PSI_QUERIES_PER_WINDOW=1
TEABAY_PSI_QUOTA_WINDOW_SECONDS=86400
TEABAY_PRIVATE_CONTACT_DISCOVERY_ENABLED=true
TEABAY_PSI_EPOCH_SECONDS=604800
TEABAY_PSI_KEY_RETENTION_SECONDS=7776000
TEABAY_QUERY_LATENCY_FLOOR_MS=25
TEABAY_QUERY_LATENCY_JITTER_MS=10

# CORS allow-origin for browser clients hitting query endpoints.
# TEABAY_CORS_ALLOW_ORIGIN=https://app.example

# Optional one-shot Prometheus text push target. There is no automatic
# in-process schedule; scrape TEABAY_METRICS_BIND or drive this externally.
# TEABAY_OTLP_ENDPOINT=http://otel-collector:9464/metrics

# Bearer token required by /_arkret/local/admin/* operator endpoints.
# TEABAY_ADMIN_TOKEN=change-me

# Ed25519 receipt signing key for operator takedown receipts. This is the raw
# 32-byte signing key encoded as unpadded base64url or standard padded base64.
# TEABAY_RECEIPT_SIGNING_KEY_B64=BASE64URL32
# TEABAY_RECEIPT_KEY_ID=did:web:directory.localhost#teabay-receipt-1

# Development-mode flag. When true, accept ephemeral signing keys and skip
# production trust checks unrelated to identity commitments (DEV ONLY —
# production MUST be false). Resolution commitments remain mandatory.
TEABAY_DEVELOPMENT_MODE=false
