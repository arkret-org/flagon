{
  "profile": "cx.profile.directory_service.v1",
  "issued": "2026-05-10",
  "source": "contrix-spec sync cab459d (conformance-profiles.json#/profile_requirements/cx.profile.directory_service.v1)",
  "description": "Contrix v1 Directory Service profile baseline. Directory Services index resource-signed discovery state, expose blinded search/resolve endpoints, and support at least one §8 ingest mode without becoming a source of truth.",
  "required_endpoints": [
    "cx.directory.describe",
    "cx.directory.search_realms",
    "cx.directory.resolve_realm",
    "cx.directory.search_organizations",
    "cx.directory.resolve_organization",
    "cx.directory.search_actors",
    "cx.directory.search_users",
    "cx.directory.resolve_handle",
    "cx.directory.announce",
    "cx.directory.withdraw",
    "cx.directory.subscribe"
  ],
  "required_event_kinds": [
    "cx.realm.discovery",
    "cx.organization.discovery",
    "cx.actor.discovery",
    "cx.applet.discovery",
    "cx.handle.discovery"
  ],
  "optional_extensions": [
    "cx.private_contact_discovery.v1",
    "pull_mode_ingest",
    "webhook_fanout",
    "restricted_query_proofs",
    "operator_console"
  ]
}
