# syntax=docker/dockerfile:1.7
# Static Glory/Sapid audit console served by nginx.
# docker build --build-context arkret-rust-sdk=../arkret-rust-sdk \
#   --build-context glory=../../glory-rs/glory \
#   --build-context sapid=../../glory-rs/sapid -f Dockerfile.admin .
FROM --platform=$BUILDPLATFORM rust:trixie AS builder
RUN apt-get update && apt-get install -y python3 && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo install wasm-bindgen-cli --version 0.2.129 --locked
WORKDIR /workspace
COPY --from=arkret-rust-sdk . ./arkret-rust-sdk
COPY --from=glory Cargo.toml /glory-rs/glory/Cargo.toml
COPY --from=glory crates /glory-rs/glory/crates
COPY --from=sapid Cargo.toml README.md /glory-rs/sapid/
COPY --from=sapid src /glory-rs/sapid/src
COPY --from=sapid styles /glory-rs/sapid/styles
COPY . ./flagon
WORKDIR /workspace/flagon
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/workspace/flagon/target \
    python3 scripts/build-admin-web.py --release --out-dir /workspace/dist

FROM nginx:stable-alpine AS runtime

RUN apk upgrade --no-cache

# nginx by default runs as root only for the master process; the
# worker process drops to `nginx` user. Override the conf so the
# SPA is served from /usr/share/nginx/html with single-page-app
# fallback (any unmatched path falls back to index.html so client-
# side routes don't 404).
RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /workspace/dist /usr/share/nginx/html

RUN printf '%s\n' \
    'server {' \
    '    listen 8080;' \
    '    listen [::]:8080;' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '    server_tokens off;' \
    '    # P5 HIGH — admin SPA security headers. CSP locks script/style' \
    '    # to self; wasm-unsafe-eval is required for the Glory WASM' \
    '    # runtime. Frame ancestors are denied so the admin cannot be' \
    '    # embedded in a third-party iframe.' \
    '    add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'wasm-unsafe-eval'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; img-src '"'"'self'"'"' data: blob:; connect-src '"'"'self'"'"';" always;' \
    '    add_header X-Content-Type-Options "nosniff" always;' \
    '    add_header X-Frame-Options "DENY" always;' \
    '    add_header Referrer-Policy "no-referrer" always;' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '    location = /health {' \
    '        access_log off;' \
    '        return 200 "ok\n";' \
    '        add_header Content-Type text/plain;' \
    '    }' \
    '}' > /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider \
        "http://127.0.0.1:8080/health" || exit 1

# nginx:alpine drops privileges for worker processes automatically.
CMD ["nginx", "-g", "daemon off;"]
