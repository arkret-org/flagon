# syntax=docker/dockerfile:1.7
#
# flagon admin SPA image — Dioxus WASM build served by nginx. Build
# from the arkret root with:
#
#   docker build \
#     --build-context arkret-rust-sdk=../arkret-rust-sdk \
#     -f Dockerfile.admin -t flagon-admin .
#
# P2E.4 — splits the admin SPA out of the server image so operators
# can deploy / scale the front-end independently of the server
# (canary releases, CDN fronting, etc.).

FROM --platform=$BUILDPLATFORM rust:trixie AS builder

ARG BUILDARCH

WORKDIR /workspace

# flagon depends on the local Arkret SDK by path; admin currently
# does NOT import the SDK directly but we keep the build context
# stable so a future shared module (e.g. typed wire structs) does not
# need a separate build wiring.
COPY --from=arkret-rust-sdk . ./arkret-rust-sdk
COPY . ./flagon

WORKDIR /workspace/flagon

# wasm32 target + dx (dioxus-cli) for the static SPA build.
RUN rustup target add wasm32-unknown-unknown

# Use the matching official CLI release and verify its published checksum.
# Compiling the CLI from source previously occupied most of the CI job window.
RUN case "$BUILDARCH" in \
        amd64) dx_arch=x86_64 ;; \
        arm64) dx_arch=aarch64 ;; \
        *) echo "Unsupported Dioxus CLI build architecture: $BUILDARCH"; exit 1 ;; \
    esac && \
    dx_url="https://github.com/DioxusLabs/dioxus/releases/download/v0.7.10/dx-${dx_arch}-unknown-linux-gnu" && \
    curl --fail --location --retry 5 "$dx_url.tar.gz" --output /tmp/dx.tar.gz && \
    curl --fail --location --retry 5 "$dx_url.sha256" --output /tmp/dx.sha256 && \
    dx_hash="$(awk '$2 ~ /\.tar\.gz$/ {print $1}' /tmp/dx.sha256)" && \
    echo "$dx_hash  /tmp/dx.tar.gz" | sha256sum --check - && \
    tar -xzf /tmp/dx.tar.gz -C /usr/local/bin dx && \
    rm /tmp/dx.tar.gz /tmp/dx.sha256 && \
    dx --version

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/workspace/flagon/target \
    build_ok=false && \
    for i in 1 2 3; do \
        if dx build -p admin --release --debug-symbols false; then \
            build_ok=true; \
            break; \
        fi; \
        echo "Retry $i..." && sleep 10; \
    done && \
    test "$build_ok" = true && \
    dist_dir="$(find /workspace/flagon/target/dx -type d -path '*/release/web/public' | head -n 1)" && \
    test -n "$dist_dir" && \
    mkdir -p /workspace/dist && \
    cp -r "$dist_dir"/* /workspace/dist/

FROM nginx:stable-alpine AS runtime

RUN apk upgrade --no-cache

# nginx by default runs as root only for the master process; the
# worker process drops to `nginx` user. Override the conf so the
# SPA is served from /usr/share/nginx/html with single-page-app
# fallback (any unmatched path falls back to index.html so client-
# side routes don't 404).
RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /workspace/dist /usr/share/nginx/html

RUN printf '%s\n' \
    'server {' \
    '    listen 8080;' \
    '    listen [::]:8080;' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '    server_tokens off;' \
    '    # P5 HIGH — admin SPA security headers. CSP locks script/style' \
    '    # to self; wasm-unsafe-eval is required for the Dioxus WASM' \
    '    # runtime. Frame ancestors are denied so the admin cannot be' \
    '    # embedded in a third-party iframe.' \
    '    add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'wasm-unsafe-eval'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; img-src '"'"'self'"'"' data: blob:; connect-src '"'"'self'"'"';" always;' \
    '    add_header X-Content-Type-Options "nosniff" always;' \
    '    add_header X-Frame-Options "DENY" always;' \
    '    add_header Referrer-Policy "no-referrer" always;' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '    location = /health {' \
    '        access_log off;' \
    '        return 200 "ok\n";' \
    '        add_header Content-Type text/plain;' \
    '    }' \
    '}' > /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider \
        "http://127.0.0.1:8080/health" || exit 1

# nginx:alpine drops privileges for worker processes automatically.
CMD ["nginx", "-g", "daemon off;"]
